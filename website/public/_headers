# Response headers, which Cloudflare reads from this file when it deploys the
# site. Everything not listed here keeps Cloudflare's default, which has
# browsers check for changes on each visit. On our.are.why.soy that relies on
# a Cache Rule in the why.soy zone set to "Respect origin TTL"; without it the
# zone's Browser Cache TTL stretches this to 4 hours.

# The fonts never change, so browsers can keep them for a year without
# checking back.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The stylesheets are named for their contents (see scripts/buildWebsite.tsx),
# so a changed one always has a new address, and browsers can keep each for
# a year without checking back.
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

# Every response: only the site's own styles, fonts, images and video may
# load, and no scripts at all (the site has none); other sites can't show it
# in a frame; browsers mustn't guess file types; links out send only the
# site's address, not the page's.
/*
  Content-Security-Policy: default-src 'none'; style-src 'self'; font-src 'self'; img-src 'self'; media-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# The policy is for pages; the files they load go without it, so a browser's
# built-in viewer opens the resume's pdf and the art's originals unhindered.
/assets/*
  ! Content-Security-Policy
